{
  "name": "offlibrary",
  "version": "0.2.2",
  "description": "Declarative offline asset management for the web: Background Fetch when available, a resumable streaming fallback when not, plus quota, eviction, range-request serving for offline media and a Workbox plugin.",
  "keywords": [
    "background-fetch",
    "offline",
    "pwa",
    "service-worker",
    "cache-api",
    "download",
    "podcast",
    "progressive-web-app",
    "range-requests",
    "storage",
    "indexeddb",
    "workbox",
    "workbox-plugin"
  ],
  "homepage": "https://salnikov.no/offlibrary/",
  "bugs": {
    "url": "https://github.com/webmaxru/offlibrary/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webmaxru/offlibrary.git"
  },
  "license": "MIT",
  "author": "Maxim Salnikov (https://github.com/webmaxru)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sw": {
      "types": "./dist/sw.d.ts",
      "import": "./dist/sw.js",
      "default": "./dist/sw.js"
    },
    "./workbox": {
      "types": "./dist/workbox.d.ts",
      "import": "./dist/workbox.js",
      "default": "./dist/workbox.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "sw": [
        "./dist/sw.d.ts"
      ],
      "workbox": [
        "./dist/workbox.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/types/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/build.mjs && vitest run --config vitest.e2e.config.ts",
    "size": "node scripts/size.mjs",
    "demo:build": "node scripts/build-demo.mjs",
    "demo": "node scripts/build-demo.mjs && node scripts/serve.mjs demo/dist",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run size",
    "check:package": "node scripts/build.mjs && node scripts/check-package.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-range-requests": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
